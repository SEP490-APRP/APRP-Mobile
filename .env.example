# URL backend Spring Boot (có /api ở cuối, giống VITE_API_URL của bản web).
# Bỏ trống: Android emulator dùng http://10.0.2.2:8080/api, iOS simulator dùng http://localhost:8080/api.
# Điện thoại thật: dùng IP LAN của máy chạy BE, ví dụ http://192.168.1.10:8080/api
EXPO_PUBLIC_API_URL=

# Địa chỉ bản web, dùng cho link chia sẻ/giới thiệu
EXPO_PUBLIC_WEB_URL=https://capnong.vn

# true để dùng dữ liệu giả trong src/mocks thay vì gọi API
EXPO_PUBLIC_USE_MOCK=false
