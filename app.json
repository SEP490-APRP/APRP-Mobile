{
  "expo": {
    "name": "CapNong",
    "slug": "capnong-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.nongsanxauma"
    },
    "android": {
      "package": "com.nongsanxauma",
      "versionCode": 1,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/logo-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/images/logo-icon.png",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#f8faf6"
        }
      ],
      "expo-image",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "CapNong cần quyền truy cập ảnh để bạn đổi ảnh đại diện và đăng ảnh nông sản.",
          "cameraPermission": "CapNong cần dùng camera để bạn chụp ảnh nông sản khi đăng bán."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "CapNong cần vị trí của bạn để tìm đơn giao gần và cho người mua theo dõi đường giao hàng."
        }
      ]
    ],
    "scheme": "capnong",
    "experiments": {
      "typedRoutes": true
    }
  }
}
